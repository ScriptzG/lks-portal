# --- Core ---
# Now a real Supabase Postgres connection string (Project Settings → Database → Connection
# string → URI). Started life on local SQLite; the schema was written to be portable so the
# switch was a one-line datasource change plus a data migration — no application code changes.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- Service mode ---
# true = use built-in mock adapters (no external accounts needed)
# false = use the real adapters below (requires real keys)
MOCK_SERVICES=true

# --- Netlify (used only when MOCK_SERVICES=false) ---
NETLIFY_API_TOKEN=

# --- Stripe (used only when MOCK_SERVICES=false) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (used only when MOCK_SERVICES=false) ---
EMAIL_PROVIDER="resend"
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="LKS Systems <no-reply@lks.systems>"

# --- Supabase (future swap-in for auth/storage, not required now) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
